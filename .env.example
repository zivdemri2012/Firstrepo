# Weekly Recap — copy to .env (never commit .env). Passwords are NOT stored here:
# logins are done manually in a browser window and only the session is kept locally.

# ---- general ----
WR_PROFILE=default            # one profile per student; each has its own database
WR_SOURCES=mashov,classroom,cet,classit
WR_PORT=8765                  # dashboard: http://localhost:8765 (bound to 127.0.0.1 only)
WR_TIMEZONE=Asia/Jerusalem
WR_LOOKBACK_DAYS=14           # on first sync, older messages count as already-seen
WR_SERVER_IDLE_HOURS=6        # background server exits after this many idle hours
WR_HEADLESS=true
# WR_CHROME_PATH=/mnt/c/Program Files/Google/Chrome/Application/chrome.exe

# ---- משוב (Mashov) ----
# The login page address you use (to be provided — not guessed by the tool).
MASHOV_URL=

# ---- Google Classroom (official API, read-only) ----
CLASSROOM_ENABLED=false
# Default location: data/profiles/<profile>/secrets/classroom_client.json
# CLASSROOM_CLIENT_SECRETS=

# ---- לשון והבעה — מט"ח (CET) ----
CET_URL=

# ---- ClassIt — מתמטיקה ----
CLASSIT_URL=

# ---- גלים פרו (Galim Pro) — optional, add 'galim' to WR_SOURCES ----
GALIM_URL=
